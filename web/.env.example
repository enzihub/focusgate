# FocusGate web (Next.js). Copy to .env.local and fill in.
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres. The app uses the Neon HTTP driver; locally, run src/db/docker-compose.yml
# and point this at the neon-proxy (see README).
DATABASE_URL=

# FocusGate core API (for "send me my brief now")
FOCUSGATE_CORE_API_URL=http://localhost:8000
FOCUSGATE_CORE_API_KEY=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
SIGNING_SECRET=

# Slack app (OAuth "Add to Slack")
NEXT_PUBLIC_SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Stripe (optional billing)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK1=

# Optional
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_DEMO_BOOKING_URL=
NEXT_PUBLIC_AUTHORIZED_EMAILS=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
