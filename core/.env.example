# FocusGate core (FastAPI + Celery). Copy to .env.development and fill in.
ENVIRONMENT=development

# Shared secret the web app sends as X-API-Key
API_KEY=

# Postgres (same database as the web app)
DATABASE_URL=

# Redis for the Celery broker and the send queue
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Scheduler (seconds)
PRODUCE_INTERVAL_SECONDS=3600
CONSUME_INTERVAL_SECONDS=60

# AI (Gemini writes the brief)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Slack app
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
# Optional: channel that gets a team brief every morning at 05:00 UTC
TEAM_SLACK_CHANNEL_ID=

# Clerk (to fetch each user's Slack OAuth token)
CLERK_SECRET_KEY=

# Email (Mailtrap sending API)
MAILTRAP_API_TOKEN=
EMAIL_SUBJECT=
FROM_EMAIL=
FROM_NAME=

# Email template
LOGO_URL=
APP_URL=

# Optional
SENTRY_DSN=
SCRAPEOPS_API_KEY=
